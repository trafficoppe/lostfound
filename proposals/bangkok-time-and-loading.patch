diff --git a/apps-script/get-all-data-cache.gs b/apps-script/get-all-data-cache.gs
new file mode 100644
--- /dev/null
+++ b/apps-script/get-all-data-cache.gs
@@ -0,0 +1,61 @@
+// Replace the existing getAllData function with this implementation.
+// Keep the existing jsonResponse, getOrCreateSheet and notification functions.
+// Cache stays inside Apps Script. Manual refresh with force=1 bypasses it.
+function getAllData(e) {
+  const force = e && e.parameter && e.parameter.force === '1';
+  const cacheKey = 'lf_all_v2_' + Math.floor(Date.now() / 30000);
+  if (!force) {
+    const cached = lfReadDataCache_(cacheKey);
+    if (cached) return jsonResponse(cached);
+  }
+  const ss = SpreadsheetApp.getActiveSpreadsheet();
+  const newSheet = getOrCreateSheet(ss);
+  const newRows = newSheet.getDataRange().getValues();
+  const headers = newRows[0];
+  const newData = newRows.slice(1).map(function(row) {
+    const obj = {};
+    headers.forEach(function(h, i) { obj[h] = row[i] == null ? '' : row[i]; });
+    return obj;
+  }).filter(function(r) { return r['ประเภท']; }).reverse();
+  const oldSheet = ss.getSheetByName('Form Responses');
+  const data = {
+    success: true,
+    generatedAt: new Date().toISOString(),
+    newData: newData,
+    oldData: oldSheet ? oldSheet.getDataRange().getValues() : []
+  };
+  lfWriteDataCache_(cacheKey, data);
+  return jsonResponse(data);
+}
+
+function lfReadDataCache_(key) {
+  try {
+    const cache = CacheService.getScriptCache();
+    const manifest = JSON.parse(cache.get(key) || 'null');
+    if (!manifest || manifest.count < 1 || manifest.count > 20) return null;
+    const keys = Array.from({length:manifest.count}, function(_, i) { return manifest.id + ':' + i; });
+    const chunks = cache.getAll(keys);
+    if (keys.some(function(k) { return !chunks[k]; })) return null;
+    const bytes = Utilities.base64Decode(keys.map(function(k) { return chunks[k]; }).join(''));
+    return JSON.parse(Utilities.ungzip(Utilities.newBlob(bytes, 'application/gzip')).getDataAsString('UTF-8'));
+  } catch (err) {
+    return null; // Eviction or cache errors fall back to the spreadsheet.
+  }
+}
+
+function lfWriteDataCache_(key, data) {
+  try {
+    const encoded = Utilities.base64Encode(Utilities.gzip(Utilities.newBlob(JSON.stringify(data), 'application/json')).getBytes());
+    const count = Math.ceil(encoded.length / 80000);
+    if (count > 20) return;
+    const id = key + ':' + Utilities.getUuid();
+    const chunks = {};
+    for (let i = 0; i < count; i++) chunks[id + ':' + i] = encoded.slice(i * 80000, (i + 1) * 80000);
+    const cache = CacheService.getScriptCache();
+    cache.putAll(chunks, 35);
+    // Publish the manifest last. Concurrent writers cannot mix chunk sets.
+    cache.put(key, JSON.stringify({id:id, count:count}), 35);
+  } catch (err) {
+    // Caching is optional and must never prevent reading live data.
+  }
+}
