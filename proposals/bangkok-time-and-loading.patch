+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+const path = require('node:path');
+const base = path.resolve(__dirname, '..');
+const LF = require('../assets/lf-data.js');
+const iso = LF.parseDate('2026-10-18T11:27:46.000Z');
+assert.equal(LF.parts(iso).hour,18);
+assert.equal(iso.toISOString(), '2026-10-18T11:27:46.000Z');
+for (const value of ['2026-10-18 18:27:46','18/10/2026 18:27:46','18/10/2569 18:27:46','2026-10-18T18:27:46+07:00']) {
+  assert.equal(LF.parseDate(value).getTime(), iso.getTime(), value);
+}
+assert.equal(LF.parts(LF.parseDate('2026-10-18 3:54:12')).hour,3);
+assert.equal(LF.parseDate('31/02/2026'), null);
+assert.equal(LF.parseDate('garbage'), null);
+assert.equal(LF.parseDate(''), null);
+assert.equal(LF.todayISO(LF.parseDate('2026-10-17T17:01:00Z')), '2026-10-18');
+assert.equal(LF.calendar(2026,9,1).toISOString(), '2026-09-30T17:00:00.000Z');
+assert.equal(LF.calendar(2026,10,0,23,59,59).toISOString(), '2026-10-31T16:59:59.000Z');
+for (const file of fs.readdirSync(base).filter(x=>x.endsWith('.html'))) {
+  const html = fs.readFileSync(path.join(base,file),'utf8');
+  for (const m of html.matchAll(/<script(?:\s[^>]*)?>([\s\S]*?)<\/script>/gi)) new vm.Script(m[1], {filename:file});
+}
+function context(file) {
+  const html=fs.readFileSync(path.join(base,file),'utf8');
+  const el={addEventListener(){},style:{},classList:{add(){},remove(){}},value:''};
+  const ctx=vm.createContext({LFData:LF,window:{},document:{addEventListener(){},getElementById(){return el;},querySelectorAll(){return [];}},console,setTimeout(){},clearTimeout(){},setInterval(){},clearInterval(){}});
+  for(const m of html.matchAll(/<script(?:\s[^>]*)?>([\s\S]*?)<\/script>/gi)) vm.runInContext(m[1],ctx);
+  return ctx;
+}
+for (const file of ['index.html','dashboard.html','lostfound_list.html','lf_report_export.html']) {
+  const ctx=context(file);
+  const parser=file==='index.html'?'parseDate':'parseAnyDate';
+  assert.equal(vm.runInContext(`${parser}('2026-10-18T11:27:46.000Z').getTime()`,ctx),iso.getTime(),file);
+}
+if (process.env.LF_API_FIXTURE && fs.existsSync(process.env.LF_API_FIXTURE)) {
+  const gallery=context('index.html');
+  gallery.raw=JSON.parse(fs.readFileSync(process.env.LF_API_FIXTURE,'utf8'));
+  const summary=vm.runInContext(`(()=>{const items=[...parseNewSheet(raw.newData),...parseOldSheetRaw(raw.oldData)];return {total:items.length,latest:fmtDate(items[0].dateObj),valid:items.filter(x=>x.dateObj).length};})()`,gallery);
+  assert.match(summary.latest,/18:27/);
+  assert.equal(summary.valid,summary.total);
+  console.log(JSON.stringify({timezone:process.env.TZ||'system',...summary}));
+}
+(async()=>{
+  let calls=0,resolveFetch;
+  const original=global.fetch;
+  global.fetch=()=>{calls++;return new Promise(resolve=>resolveFetch=resolve);};
+  const one=LF.getAllData('https://test.invalid');
+  const two=LF.getAllData('https://test.invalid');
+  assert.equal(one,two);
+  resolveFetch({ok:true,json:async()=>({success:true,newData:[],oldData:[]})});
+  await one; assert.equal(calls,1);
+  global.fetch=async()=>({ok:true,json:async()=>({success:false,error:'test'})});
+  await assert.rejects(LF.getAllData('https://test.invalid'));
+  global.fetch=original;
+  console.log('Date, page syntax, actual API rows, request deduplication and error validation passed.');
+})().catch(e=>{console.error(e);process.exitCode=1;});
